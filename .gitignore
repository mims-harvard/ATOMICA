# Force include the specific file
!/data/tokenizer/vocabs/ps_vocab_300.txt
!/data/tokenizer/vocabs/ps_vocab_500.txt

# Other files
visualise_interactions.ipynb
data/example/test_example.ipynb
data/mmap_dataset.py
interaction_profiler/*
src/atomica.egg-info
third_party

# Internal planning files
PLAN.md
install.log

# Tutorial code is part of the repository even where the extension is ignored above
!tutorials/**/*.sh
!tutorials/**/*.csv
!tutorials/**/*.txt

# The metal-coordination tutorial ships its pockets and MetalPDB labels (28 MB). They are inputs,
# not generated output. Its own .gitignore still excludes embeddings/ and predictions/.
!tutorials/9_metal_coordination/data/**/*.parquet
# A tutorial's checkpoints/ says which model files it needs and where they come from.
# The blanket `checkpoints` rule above hides the directory, so re-include it explicitly;
# git cannot see into an excluded directory, so the directory itself has to be listed.
!tutorials/*/checkpoints/
!tutorials/*/checkpoints/README.md

# structures downloaded on demand by make_plip_labels.py
tutorials/6_interact_score/pdb_cache/
